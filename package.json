{
  "name": "youtube-watch-later-hotkeys-extension",
  "description": "Minimal. Simple. Sufficient.",
  "version": "1.0.0",
  "scripts": {
    "compile": "tsc --noEmit",
    "dev": "vite",
    "build": "npm run clean:dist && vite build",
    "test": "vitest",
    "lint": "eslint shared/*.js",
    "build:chrome": "npm run clean:chrome && TARGET=chrome vite build",
    "build:firefox": "npm run clean:firefox && TARGET=firefox vite build",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "zip:chrome": "cd dist-chrome && zip -r ../ywlhe-chrome.zip . && cd ..",
    "zip:firefox": "cd dist-firefox && zip -r ../ywlhe-firefox.zip . && cd ..",
    "zip:all": "npm run zip:chrome && npm run zip:firefox",
    "clean:chrome": "rm -rf dist-chrome",
    "clean:firefox": "rm -rf dist-firefox",
    "clean:dist": "npm run clean:chrome && npm run clean:firefox",
    "clean:zip": "rm -rf ywlhe-*.zip",
    "pack": "npm run build:all && npm run zip:all && npm run clean:dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sashauly/youtube-watch-later-hotkeys-extension.git"
  },
  "keywords": [
    "youtube",
    "watch later",
    "hotkeys",
    "extension"
  ],
  "author": "",
  "license": "GPL-3.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/sashauly/youtube-watch-later-hotkeys-extension/issues"
  },
  "homepage": "https://github.com/sashauly/youtube-watch-later-hotkeys-extension#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/webextension-polyfill": "^0.12.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-web-extension": "^4.4.5",
    "vitest": "^3.2.4",
    "webextension-polyfill": "^0.12.0"
  }
}